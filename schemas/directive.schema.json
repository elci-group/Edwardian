{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edwardian.dev/schemas/directive.schema.json",
  "title": "Edwardian Directive",
  "type": "object",
  "required": [
    "id", "priority", "objective", "evidence_ids", "affected_components",
    "current_state", "target_state", "remediation", "validation_plan",
    "dependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EWD-D[0-9]{3}$"
    },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "objective": { "type": "string", "minLength": 1 },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^EWD-[0-9]{5}$" }
    },
    "affected_components": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "current_state": {
      "type": "string",
      "enum": [
        "portable", "windows-compatible", "configurable", "adaptable",
        "replaceable", "requires-implementation", "architecturally-incompatible",
        "unknown"
      ]
    },
    "target_state": {
      "type": "string",
      "enum": [
        "portable", "windows-compatible", "configurable", "adaptable",
        "replaceable", "requires-implementation", "architecturally-incompatible",
        "unknown"
      ]
    },
    "remediation": { "type": "string", "minLength": 1 },
    "validation_plan": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EWD-D[0-9]{3}$" }
    }
  }
}
